{
  "expo": {
    "name": "ConexPass",
    "slug": "conexpass-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F7FB",
    "splash": {
      "backgroundColor": "#2B6CE0",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.conexpass.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O ConexPass usa sua localização para mostrar academias próximas de você."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2B6CE0"
      },
      "package": "com.conexpass.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O ConexPass usa sua localização para mostrar academias próximas de você."
        }
      ]
    ]
  }
}
