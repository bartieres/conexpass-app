{
  "expo": {
    "name": "ConexPass",
    "slug": "conexpass-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F7FB",
    "splash": {
      "backgroundColor": "#2B6CE0",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.conexpass.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2B6CE0"
      },
      "package": "com.conexpass.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
