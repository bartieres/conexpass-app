{
  "expo": {
    "name": "ConexPass",
    "slug": "conexpass-app",
    "version": "1.0.0",
    "scheme": "conexpass",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F7FB",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.conexpass.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O ConexPass usa sua localização para mostrar estabelecimentos e atividades próximas de você."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2B6CE0"
      },
      "package": "com.conexpass.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "versionCode": 1
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O ConexPass usa sua localização para mostrar estabelecimentos e atividades próximas de você."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "565152a7-b1f8-438e-b920-4d1624114e26"
      }
    }
  }
}
